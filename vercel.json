{
  "rewrites": [
    { "source": "/ops", "destination": "/ops-dashboard/index.html" },
    { "source": "/ops/", "destination": "/ops-dashboard/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/ops-dashboard/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/ops-dashboard/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ops",
      "destination": "/ops-dashboard/",
      "permanent": false
    },
    {
      "source": "/ops/",
      "destination": "/ops-dashboard/",
      "permanent": false
    }
  ]
}
